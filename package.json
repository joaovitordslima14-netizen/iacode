{
  "name": "iacode",
  "displayName": "IAcode",
  "description": "Gere aplicativos e sites no VS Code a partir de uma ideia e das linguagens escolhidas.",
  "version": "0.4.9",
  "publisher": "codenova-labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/joaovitordslima14-netizen/iacode.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "iacode.createProject",
        "title": "IAcode: Criar projeto com IA",
        "category": "IAcode"
      },
      {
        "command": "iacode.openChat",
        "title": "IAcode: Abrir chat independente",
        "category": "IAcode"
      }
    ],
    "configuration": {
      "title": "IAcode",
      "properties": {
        "iacode.providerUrl": {
          "type": "string",
          "default": "https://iacode-lua-pequena-2cea.joaovitor-dslima14.workers.dev/v1",
          "description": "URL base da API de IA hospedada na nuvem.",
          "scope": "machine-overridable"
        },
        "iacode.model": {
          "type": "string",
          "default": "@cf/meta/llama-3.2-3b-instruct",
          "description": "Modelo usado para gerar o projeto.",
          "scope": "machine-overridable"
        },
        "iacode.apiKey": {
          "type": "string",
          "default": "",
          "description": "Chave da API cloud, armazenada como segredo do VS Code.",
          "scope": "machine-overridable",
          "password": true
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile && vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.5.0"
  }
}
